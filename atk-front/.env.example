# Базовый URL API (без завершающего слэша — в requester добавится один слэш).
# Локально:
# NEXT_PUBLIC_API_BASE=http://localhost:8000/ru/api/v1
# Продакшен (тот же домен, что и сайт, префикс языка и /api/v1):
# NEXT_PUBLIC_API_BASE=https://ваш-домен.kg/ru/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:8000/ru/api/v1
