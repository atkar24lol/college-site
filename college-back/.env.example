# Скопируйте в .env и заполните. Файл .env в Git не коммитится.
# cp .env.example .env

# ────────────────────────────────────────────────
# ПРОДАКШЕН — atk.kg (HTTP, без HTTPS пока)
# ────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=замените-на-случайную-строку-50-символов

ALLOWED_HOSTS=atk.kg,www.atk.kg,178.219.159.94

# CORS: откуда браузер может делать запросы к API
CORS_ALLOWED_ORIGINS=http://atk.kg,http://www.atk.kg

# CSRF: откуда разрешены POST-запросы в Django (админка, формы)
CSRF_TRUSTED_ORIGINS=http://atk.kg,http://www.atk.kg

# ────────────────────────────────────────────────
# База данных
# ────────────────────────────────────────────────
POSTGRES_DB=atk_db
POSTGRES_USER=atk_user
POSTGRES_PASSWORD=замените-на-сильный-пароль
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ────────────────────────────────────────────────
# Почта (форма обратной связи)
# ────────────────────────────────────────────────
# Gmail: нужен пароль приложения, НЕ обычный пароль аккаунта.
# myaccount.google.com → Безопасность → Пароли приложений
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ваша@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ────────────────────────────────────────────────
# Фронтенд (Next.js — вшиваются в образ при сборке)
# ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://atk.kg

# ────────────────────────────────────────────────
# HTTPS (добавить после установки SSL-сертификата)
# ────────────────────────────────────────────────
# Когда подключите Let's Encrypt и nginx начнёт слушать 443:
# CORS_ALLOWED_ORIGINS=https://atk.kg,https://www.atk.kg
# CSRF_TRUSTED_ORIGINS=https://atk.kg,https://www.atk.kg
# NEXT_PUBLIC_SITE_URL=https://atk.kg
# USE_TLS_BEHIND_PROXY=True
