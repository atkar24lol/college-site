# Скопируйте в .env и заполните. Файл .env в Git не коммитится.
#
# === Продакшен (обязательно сменить) ===
# DEBUG=False
# SECRET_KEY=<сгенерируйте длинную случайную строку>
# ALLOWED_HOSTS=ваш-домен.kg,www.ваш-домен.kg,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://ваш-домен.kg,https://www.ваш-домен.kg
# CSRF_TRUSTED_ORIGINS=https://ваш-домен.kg,https://www.ваш-домен.kg
# USE_TLS_BEHIND_PROXY=True
#
# NEXT_PUBLIC_API_BASE на фронте должен указывать на этот же хост, например:
# https://ваш-домен.kg/ru/api/v1

DEBUG=True
SECRET_KEY=change-me-to-random-string

# Хосты Django (через запятую). В проде не оставляйте только "*".
ALLOWED_HOSTS=*

# Origin фронта для CORS (через запятую, без пробелов или с пробелами — обрежутся)
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=atk_db
POSTGRES_USER=atk_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Почта
# Gmail: обычный пароль от аккаунта НЕ подходит. Нужен пароль приложения:
# Аккаунт Google → Безопасность → двухэтапная проверка → Пароли приложений → «Почта».
# В .env: EMAIL_HOST_USER=ваш@gmail.com, EMAIL_HOST_PASSWORD=16-символьный пароль приложения
# Адрес в админке (Email_sending.receiver) должен быть тем же Gmail, иначе письмо не уйдёт.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Локально без отправки писем (текст в консоль контейнера/терминала):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
